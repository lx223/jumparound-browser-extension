{
  "name": "jumparound",
  "version": "0.1.5",
  "description": "Cross-browser tab switcher with keyboard shortcuts",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "build:chrome": "npm run build",
    "build:safari": "npm run build && npm run convert:safari",
    "convert:safari": "xcrun safari-web-extension-converter dist --app-name JumpAround --bundle-identifier jumparound.lanxiao.dev",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.1.43",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
